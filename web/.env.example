# Copy to .env.local for local development, or set these in the Vercel
# project's Environment Variables settings for production/preview.
#
# When both are set, every page requires this username/password (HTTP Basic
# Auth) before it loads. Leave unset to develop without the auth prompt.
SITE_USER=
SITE_PASSWORD=

# Required for the web editor at /edit (src/app/edit) to work.
#
# EDIT_PASSWORD gates the editor itself (separate from SITE_PASSWORD above —
# anyone with the viewing password can read the site, but only this password
# can save changes).
#
# GITHUB_TOKEN is a GitHub token with contents:write on itoaogaku/itonomaki;
# the editor commits saved changes directly via the GitHub API. Leave both
# unset to run without the editor (viewing still works normally).
EDIT_PASSWORD=
GITHUB_TOKEN=

# Branch the editor commits to. Vercel sets this automatically per-deploy
# (VERCEL_GIT_COMMIT_REF), so this is only needed for local dev.
EDIT_TARGET_BRANCH=

# Required for uploading photos from the editor (/edit). Photos are resized/
# compressed then uploaded via FTP to the trainer's existing Xserver hosting
# (see src/lib/ftpImages.ts) rather than bundled into the git repo/deployment.
FTP_HOST=
FTP_USER=
FTP_PASSWORD=

# Required for the separate "stopwatch" app's team-shared voice-recording
# feature to accept uploads/deletes (GET listing is always public). That app
# calls /api/stretch-audio directly (cross-origin) and sends this value as
# `Authorization: Bearer <token>`. Reuses the same FTP_* credentials above to
# actually store the audio files (see src/lib/ftpAudio.ts). Leave unset to
# disable uploads/deletes (listing/playback keeps working).
STRETCH_AUDIO_TOKEN=
